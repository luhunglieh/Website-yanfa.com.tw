---
import Layout from '../layouts/Layout.astro';
import BrandCard from '../components/BrandCard.astro';
import { brandsData } from '../data/brands';
import { Image } from 'astro:assets';
import bannerBg from '../assets/images/footer-bg.jpg';

// Import all logos
import jackconLogo from '../assets/logos/jackcon.png';
import emcLogo from '../assets/logos/emc.png';
import nikoLogo from '../assets/logos/niko-sem.png';
import utcLogo from '../assets/logos/utc.png';
import brtLogo from '../assets/logos/brt.png';
import erisLogo from '../assets/logos/eris.png';
import matrixLogo from '../assets/logos/matrix.png';
import cteLogo from '../assets/logos/cte.png';
import basicLogo from '../assets/logos/basic.png';

const logoMap: Record<string, any> = {
  jackcon: jackconLogo,
  emc: emcLogo,
  'niko-sem': nikoLogo,
  utc: utcLogo,
  brt: brtLogo,
  eris: erisLogo,
  matrix: matrixLogo,
  cte: cteLogo,
  basic: basicLogo
};
---

<Layout title="代理品牌 | 仰發科技有限公司" description="仰發科技代理品牌陣容：融欣 Jackcon, 杰力科技 EMC, 尼克森 NIKO-SEM, 友順科技 UTC, 佰鴻工業 BRT, 德微科技 ERIS, 鑫茂微 MATRIX, 科特電子 CTE, 基本半導體 BASiC。" currentPath="/brands/">
  
  <!-- Top Banner -->
  <section class="relative bg-slate-950 text-white py-16 sm:py-24 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <Image 
        src={bannerBg} 
        alt="代理品牌 Banner" 
        class="w-full h-full object-cover object-center opacity-85 brightness-105"
        loading="eager"
      />
      <!-- Soft translucent gradient for text legibility without dimming the image -->
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-slate-950/30 to-slate-950/40"></div>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-white drop-shadow-md">
        代理品牌
      </h1>
      <p class="text-slate-100 max-w-2xl mx-auto text-base sm:text-lg drop-shadow-sm font-medium">
        嚴選國內外頂尖半導體與電子元件製造大廠，提供原廠品質保證與完整技術支援
      </p>
    </div>
  </section>

  <!-- Brands Grid Section -->
  <section class="py-16 sm:py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
        {brandsData.map((brand) => (
          <BrandCard 
            name={brand.name}
            fullName={brand.fullName}
            logo={logoMap[brand.id]}
            description={brand.description}
            officialUrl={brand.officialUrl}
            badge={brand.badge}
          />
        ))}
      </div>
    </div>
  </section>

</Layout>
