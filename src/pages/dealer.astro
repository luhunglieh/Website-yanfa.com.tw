---
import Layout from '../layouts/Layout.astro';
import BrandCard from '../components/BrandCard.astro';
import { dealersData } from '../data/dealers';
import { Image } from 'astro:assets';
import bannerBg from '../assets/images/banner-bg.jpeg';

// Import dealer logos
import littelfuseLogo from '../assets/logos/littelfuse.png';
import nichiconLogo from '../assets/logos/nichicon.png';
import chemiconLogo from '../assets/logos/nippon-chemicon.png';
import panasonicLogo from '../assets/logos/panasonic.png';
import toshibaLogo from '../assets/logos/toshiba.png';

const logoMap: Record<string, any> = {
  littelfuse: littelfuseLogo,
  nichicon: nichiconLogo,
  'nippon-chemicon': chemiconLogo,
  panasonic: panasonicLogo,
  toshiba: toshibaLogo
};
---

<Layout title="經銷服務 | 仰發科技有限公司" description="仰發科技經銷服務品牌：Littelfuse, NICHICON, NIPPON CHEMI-CON, Panasonic, TOSHIBA 等世界級電子零件與電容器。" currentPath="/dealer/">
  
  <!-- Top Banner -->
  <section class="relative bg-slate-900 text-white py-16 sm:py-24 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <Image 
        src={bannerBg} 
        alt="經銷服務 Banner" 
        class="w-full h-full object-cover object-center opacity-30"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-900/80 to-slate-950/90"></div>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center px-3.5 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-semibold uppercase tracking-wider">
        Dealer & Distribution Services
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-white">
        經銷服務
      </h1>
      <p class="text-slate-300 max-w-2xl mx-auto text-base sm:text-lg">
        引進全球領導品牌電子零組件與電容產品，以長期備料與多元供貨滿足客戶全方位需求
      </p>
    </div>
  </section>

  <!-- Dealers Grid Section -->
  <section class="py-16 sm:py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
        {dealersData.map((dealer) => (
          <BrandCard 
            name={dealer.name}
            fullName={dealer.fullName}
            logo={logoMap[dealer.id]}
            description={dealer.description}
            officialUrl={dealer.officialUrl}
            badge={dealer.badge}
          />
        ))}
      </div>
    </div>
  </section>

</Layout>
