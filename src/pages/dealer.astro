---
import Layout from '../layouts/Layout.astro';
import BrandCard from '../components/BrandCard.astro';
import { dealersData } from '../data/dealers';
import { Image } from 'astro:assets';
import bannerBg from '../assets/images/dealer-global-banner-v3.jpg';

// Import dealer logos
import littelfuseLogo from '../assets/logos/littelfuse.png';
import nichiconLogo from '../assets/logos/nichicon.png';
import chemiconLogo from '../assets/logos/nippon-chemicon.png';
import panasonicLogo from '../assets/logos/panasonic.png';
import toshibaLogo from '../assets/logos/toshiba.png';

const logoMap: Record<string, any> = {
  littelfuse: littelfuseLogo,
  nichicon: nichiconLogo,
  'nippon-chemicon': chemiconLogo,
  panasonic: panasonicLogo,
  toshiba: toshibaLogo
};
---

<Layout title="經銷服務 | 仰發科技有限公司" description="仰發科技經銷服務品牌：Littelfuse, NICHICON, NIPPON CHEMI-CON, Panasonic, TOSHIBA 等世界級電子零件與電容器。" currentPath="/dealer/">
  
  <!-- Top Banner -->
  <section class="relative bg-slate-950 text-white min-h-[400px] lg:min-h-[480px] py-16 sm:py-24 flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <Image 
        src={bannerBg} 
        alt="經銷服務全球供應鏈" 
        class="w-full h-full object-cover object-center opacity-85 brightness-105"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-950/20 to-slate-950/30"></div>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-white drop-shadow-md">
        經銷服務
      </h1>
      <p class="text-slate-100 max-w-2xl mx-auto text-base sm:text-lg drop-shadow-md font-medium">
        引進全球領導品牌電子零組件與電容產品，以多元供貨滿足客戶需求
      </p>
    </div>
  </section>

  <!-- Dealers Grid Section -->
  <section class="py-16 sm:py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
        {dealersData.map((dealer) => (
          <BrandCard 
            name={dealer.name}
            fullName={dealer.fullName}
            logo={logoMap[dealer.id]}
            description={dealer.description}
            officialUrl={dealer.officialUrl}
            badge={dealer.badge}
          />
        ))}
      </div>
    </div>
  </section>

</Layout>
